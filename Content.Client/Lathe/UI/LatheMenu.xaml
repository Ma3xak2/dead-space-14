<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="{Loc 'lathe-menu-title'}"
    MinSize="600 480"
    SetSize="800 540">

    <!-- DS14-start-->
    <BoxContainer
        Orientation="Horizontal"
        VerticalExpand="True"
        HorizontalExpand="True"
        SeparationOverride="8"
        Margin="4">

        <!-- Left Col-->
        <BoxContainer
            Orientation="Vertical"
            VerticalExpand="True"
            HorizontalExpand="True"
            SeparationOverride="6">

            <!-- Search + Filter bar -->
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          SeparationOverride="5">
                <LineEdit
                    Name="SearchBar"
                    PlaceHolder="{Loc 'lathe-menu-search-designs'}"
                    HorizontalExpand="True"
                    StyleClasses="DS14MenuInput"/>
                <OptionButton
                    Name="FilterOption"
                    MinWidth="110"
                    StyleClasses="DS14MenuProfileControl"/>
            </BoxContainer>

            <!-- Recipe list -->
            <PanelContainer
                VerticalExpand="True"
                HorizontalExpand="True"
                SizeFlagsStretchRatio="4"
                StyleClasses="DS14MenuPanelDark">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer
                        Name="RecipeList"
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        RectClipContent="True"
                        SeparationOverride="2"
                        Margin="2"/>
                </ScrollContainer>
            </PanelContainer>

            <!-- Amount + Count row -->
            <PanelContainer StyleClasses="DS14MenuInset">
                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              SeparationOverride="6"
                              VerticalAlignment="Center">
                    <Label Margin="4 0 4 0"
                           Text="{Loc 'lathe-menu-amount'}"
                           StyleClasses="DS14MenuProfileLabel"/>
                    <LineEdit
                        Name="AmountLineEdit"
                        PlaceHolder="0"
                        Text="1"
                        HorizontalExpand="True"
                        StyleClasses="DS14MenuInput"/>
                    <Label Name="RecipeCount"
                           Margin="8 0 4 0"
                           MinWidth="100"
                           Align="Right"
                           StyleClasses="DS14MenuSubtitle"/>
                </BoxContainer>
            </PanelContainer>

        </BoxContainer>

        <!-- Divider -->
        <PanelContainer StyleClasses="DS14MenuAccentDim" MinWidth="1" VerticalExpand="True"/>

        <!-- Right Col-->
        <BoxContainer
            Orientation="Vertical"
            VerticalExpand="True"
            HorizontalExpand="True"
            SeparationOverride="6"
            SizeFlagsStretchRatio="1">

            <!-- Server list button — вверху правой колонки -->
            <Button
                Name="ServerListButton"
                Text="{Loc 'lathe-menu-server-list'}"
                TextAlign="Center"
                Mode="Press"
                StyleClasses="DS14MenuTopButton"
                HorizontalAlignment="Stretch"/>

            <!-- Queue section -->
            <BoxContainer
                Orientation="Vertical"
                VerticalExpand="True"
                HorizontalExpand="True"
                SizeFlagsStretchRatio="2"
                SeparationOverride="4">

                <!-- Queue header -->
                <PanelContainer StyleClasses="DS14MenuHeader">
                    <Label Text="{Loc 'lathe-menu-queue-title'}"
                           StyleClasses="DS14MenuTitle"/>
                </PanelContainer>

                <!-- Currently fabricating -->
                <BoxContainer
                    Name="FabricatingContainer"
                    Orientation="Horizontal"
                    HorizontalExpand="True">
                    <PanelContainer
                        VerticalExpand="True"
                        HorizontalExpand="True"
                        StyleClasses="DS14MenuListRow">
                        <BoxContainer Orientation="Horizontal"
                                      VerticalAlignment="Center"
                                      HorizontalExpand="True"
                                      SeparationOverride="6"
                                      Margin="4 0 4 0">
                            <PanelContainer StyleClasses="DS14MenuAccent"
                                            MinWidth="2"
                                            VerticalExpand="True"/>
                            <BoxContainer Name="FabricatingDisplayContainer"
                                          VerticalAlignment="Center"
                                          MinSize="32 32"/>
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          VerticalAlignment="Center"
                                          SeparationOverride="2">
                                <Label Text="{Loc 'lathe-menu-fabricating-message'}"
                                       StyleClasses="DS14MenuSubtitle"/>
                                <Label Name="NameLabel"
                                       RectClipContent="True"
                                       StyleClasses="DS14MenuProfileLabel"/>
                            </BoxContainer>
                            <Button
                                Name="DeleteFabricating"
                                Text="✖"
                                SetSize="32 28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTip="{Loc 'lathe-menu-delete-fabricating-tooltip'}"
                                StyleClasses="DS14MenuProfileControlDanger"/>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <!-- Queue list -->
                <PanelContainer
                    VerticalExpand="True"
                    HorizontalExpand="True"
                    StyleClasses="DS14MenuPanelDark">
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer
                            Name="QueueList"
                            Orientation="Vertical"
                            HorizontalExpand="True"
                            VerticalExpand="True"
                            RectClipContent="True"
                            SeparationOverride="2"
                            Margin="2"/>
                    </ScrollContainer>
                </PanelContainer>

            </BoxContainer>

            <!-- Divider -->
            <PanelContainer StyleClasses="DS14MenuAccentDim" MinHeight="1" HorizontalExpand="True"/>

            <!-- Materials section -->
            <BoxContainer
                Orientation="Vertical"
                VerticalExpand="True"
                HorizontalExpand="True"
                SizeFlagsStretchRatio="2"
                SeparationOverride="5">

                <PanelContainer StyleClasses="DS14MenuHeader">
                    <BoxContainer Orientation="Vertical" SeparationOverride="2">
                        <Label Text="{Loc 'lathe-menu-materials-title'}"
                               StyleClasses="DS14MenuTitle"/>
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer
                    VerticalExpand="True"
                    HorizontalExpand="True"
                    StyleClasses="DS14MenuPanelDark">
                    <BoxContainer
                        Orientation="Vertical"
                        VerticalExpand="True"
                        HorizontalExpand="True">
                        <ui:MaterialStorageControl Name="MaterialsList" SizeFlagsStretchRatio="8"/>
                    </BoxContainer>
                </PanelContainer>

            </BoxContainer>

        </BoxContainer>

    </BoxContainer>
    <!-- DS14-end -->

</DefaultWindow>
